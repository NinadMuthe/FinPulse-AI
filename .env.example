# Environment Variables — FinPulse AI Backend
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file to Git.

# ─── Application ─────────────────────────────
APP_ENV=development          # development | production | testing
APP_DEBUG=true
APP_SECRET_KEY=your-secret-key-here

# ─── Database ────────────────────────────────
# Default SQLite for local dev without PostgreSQL installed:
DATABASE_URL=sqlite:///./backend/finpulse.db
# For PostgreSQL: postgresql+psycopg://USER:PASSWORD@localhost:5432/finpulse

# ─── JWT / Auth ──────────────────────────────
JWT_SECRET_KEY=your-jwt-secret-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── LLM / AI Advisory ───────────────────────
# Use exactly ONE LLM provider key below.
GOOGLE_API_KEY=your-google-api-key-here
# OPENAI_API_KEY=your-openai-key-here   # uncomment if switching providers

# ─── Setu Account Aggregator (AA) Sandbox ────
# Obtain these from https://bridge.setu.co → AA Sandbox product
SETU_CLIENT_ID=your-setu-client-id-here
SETU_CLIENT_SECRET=your-setu-client-secret-here
SETU_PRODUCT_INSTANCE_ID=your-setu-product-instance-id-here

# ─── Logging ─────────────────────────────────
LOG_LEVEL=INFO
